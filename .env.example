# Browser calls stay same-origin. Next.js rewrites /api/* to this backend origin.
API_PROXY_TARGET=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_APP_NAME=Interview Prep AI

